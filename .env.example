# NOTE: copy thành .env rồi điền key trên máy của bạn; không chụp/nộp file .env.
# Chương trình vẫn mặc định offline, chỉ gọi API khi chạy --mode api.
# Provider: openai | openai-compatible | google-genai
LLM_PROVIDER=openai
# Tên model API chính xác có quyền truy cập; không dùng tên model trong ứng dụng Codex.
LLM_MODEL=
LLM_API_KEY=
# Điền endpoint /v1 khi dùng openai-compatible; hai provider còn lại để trống.
LLM_BASE_URL=
# function_calling tương thích rộng hơn; json_schema khi model hỗ trợ.
LLM_PLAN_METHOD=function_calling
LLM_TIMEOUT_SECONDS=30
# Mặc định tắt retry SDK để không phát sinh thêm HTTP request ngầm.
LLM_MAX_RETRIES=0
LLM_MAX_OUTPUT_TOKENS=1024
# Để trống dùng mặc định của model; có thể đặt 0 nếu model cho phép.
LLM_TEMPERATURE=
